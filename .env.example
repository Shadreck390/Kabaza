# Kabaza Environment Variables
# Copy this file to .env and fill in your actual values

# ====================
# APP CONFIGURATION
# ====================
APP_NAME=Kabaza
APP_VERSION=1.0.0
APP_BUILD=1
ENVIRONMENT=development
DEBUG=true

# ====================
# FIREBASE CONFIGURATION
# ====================
# Get these from your Firebase project settings
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ====================
# GOOGLE MAPS CONFIGURATION
# ====================
# Get this from Google Cloud Console -> Maps JavaScript API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ====================
# API CONFIGURATION
# ====================
# Development API URL
API_BASE_URL=http://192.168.8.2:3000/api

# Production API URL (uncomment for production)
# API_BASE_URL=https://api.kabaza.mw/api

# Socket.IO Server URL
SOCKET_URL=http://192.168.8.2:3000

# Production Socket URL (uncomment for production)
# SOCKET_URL=https://socket.kabaza.mw

# API Timeouts
API_TIMEOUT=30000
SOCKET_TIMEOUT=20000

# ====================
# FEATURE FLAGS
# ====================
# Enable/disable features
ENABLE_REAL_TIME_TRACKING=true
ENABLE_SOCKET=true
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_IN_APP_CHAT=true
ENABLE_SOS=false
ENABLE_MULTIPLE_PAYMENTS=true
ENABLE_BACKGROUND_LOCATION=false
ENABLE_ANALYTICS=false
ENABLE_CRASH_REPORTING=false
ENABLE_PERFORMANCE_MONITORING=true
ENABLE_DEBUG_MODE=false

# ====================
# PAYMENT CONFIGURATION
# ====================
# Mobile Money Providers
MOBILE_MONEY_PROVIDER=airtel
PAYMENT_CURRENCY=MWK

# ====================
# NOTIFICATION CONFIGURATION
# ====================
# Push notification settings
NOTIFICATION_VIBRATION=true
NOTIFICATION_SOUND=true

# ====================
# DEVELOPMENT SETTINGS
# ====================
# Log level (debug, info, warn, error)
LOG_LEVEL=debug

# Skip SSL certificate verification (development only)
SKIP_SSL_VERIFY=false
